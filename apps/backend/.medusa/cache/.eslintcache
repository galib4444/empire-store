es/digital-product/models/digital-product-download.ts",[],[],"/Users/galibmuktasin/Documents/Coding/The Empire/store-boilerplate/apps/backend/src/scripts/seed-brand.ts",[],[],"/Users/galibmuktasin/Documents/Coding/The Empire/store-boilerplate/apps/backend/src/subscribers/handle-order-placed.ts",[],[],"/Users/galibmuktasin/Documents/Coding/The Empire/store-boilerplate/apps/backend/src/workflows/create-digital-order-from-order/index.ts",[],[],"/Users/galibmuktasin/Documents/Coding/The Empire/store-boilerplate/apps/backend/src/workflows/create-digital-order-from-order/steps/create-digital-product-order.ts",[],[],{"ruleId":"284","severity":1,"message":"285","line":13,"column":3,"nodeType":"286","messageId":"287","endLine":13,"endColumn":32,"fix":"288"},{"ruleId":"284","severity":1,"message":"289","line":10,"column":3,"nodeType":"286","messageId":"287","endLine":10,"endColumn":28,"fix":"290"},{"ruleId":"291","severity":1,"message":"292","line":11,"column":46,"nodeType":"286","messageId":"293","endLine":11,"endColumn":55,"fix":"294"},{"ruleId":"295","severity":1,"message":"296","line":12,"column":37,"nodeType":"286","messageId":"297","endLine":12,"endColumn":44,"fix":"298"},{"ruleId":"299","severity":1,"message":"300","line":51,"column":9,"nodeType":"301","messageId":"302","endLine":51,"endColumn":66},{"ruleId":"303","severity":1,"message":"304","line":55,"column":11,"nodeType":"305","messageId":"306","endLine":55,"endColumn":81,"suggestions":"307"},{"ruleId":"303","severity":1,"message":"304","line":24,"column":11,"nodeType":"305","messageId":"306","endLine":24,"endColumn":71,"suggestions":"308"},"@medusajs/step-id-kebab-case","Step id `create-digital-product-step` should match the enclosing variable name or filename (expected `create-digital-product`).","Literal","idMismatch",{"range":"309","text":"310"},"Step id `delete-digital-products` should match the enclosing variable name or filename (expected `delete-digital-products-steps`).",{"range":"311","text":"312"},"@medusajs/prefer-modules-enum","Use `Modules.PRODUCT` instead of the magic string `product`.","preferModulesEnum",{"range":"313","text":"314"},"@medusajs/prefer-container-registration-keys","Use `ContainerRegistrationKeys.QUERY` instead of the magic string `query`.","preferRegistrationKey",{"range":"315","text":"316"},"@medusajs/no-service-mutations-in-api-route","Avoid calling `digitalProductModuleService.createDigitalProductDownloads(...)` directly in an API route handler. Move the mutation into a workflow step and invoke it via `someWorkflow(req.scope).run({ input })`.","MemberExpression","noMutation","@medusajs/use-medusa-error-not-generic-error","Throw `MedusaError` instead of a generic `Error`. Use `new MedusaError(MedusaError.Types.X, \"...\")` so the error maps to the correct HTTP status.","NewExpression","useMedusaError",["317"],["318"],[350,379],"\"create-digital-product\"",[345,370],"\"delete-digital-products-steps\"",[0,476],"import { Modules } from \"@medusajs/framework/utils\"\nimport { createStep, StepResponse } from \"@medusajs/framework/workflows-sdk\"\nimport DigitalProductVariantLink from \"../../../links/digital-product-variant\"\n\ntype RetrieveDigitalProductsToDeleteStepInput = {\n  product_id: string\n}\n\nexport const retrieveDigitalProductsToDeleteStep = createStep(\n  \"retrieve-digital-products-to-delete\",\n  async ({ product_id }: RetrieveDigitalProductsToDeleteStepInput, { container }) => {\n    const productService = container.resolve(Modules.PRODUCT",[0,521],"import { ContainerRegistrationKeys } from \"@medusajs/framework/utils\"\nimport { createStep, StepResponse } from \"@medusajs/framework/workflows-sdk\"\nimport DigitalProductVariantLink from \"../../../links/digital-product-variant\"\n\ntype RetrieveDigitalProductsToDeleteStepInput = {\n  product_id: string\n}\n\nexport const retrieveDigitalProductsToDeleteStep = createStep(\n  \"retrieve-digital-products-to-delete\",\n  async ({ product_id }: RetrieveDigitalProductsToDeleteStepInput, { container }) => {\n    const productService = container.resolve(\"product\")\n    const query = container.resolve(ContainerRegistrationKeys.QUERY",{"messageId":"319","data":"320","fix":"321","desc":"322"},{"messageId":"319","data":"323","fix":"324","desc":"322"},"replaceWithMedusaError",{"type":"325"},{"range":"326","text":"327"},"Replace with `new MedusaError(MedusaError.Types.UNEXPECTED_STATE, ...)` (pick the appropriate `MedusaError.Types.*`).",{"type":"325"},{"range":"328","text":"329"},"MedusaError.Types.UNEXPECTED_STATE",[0,1764],"import { MedusaError } from \"@medusajs/framework/utils\"\nimport fs from \"fs\"\nimport path from \"path\"\n\nexport type BrandCatalogItem = {\n  handle: string\n  title: string\n  subtitle?: string\n  description?: string\n  /** Pull the description from the first code block under a heading in a Markdown file. */\n  descriptionFrom?: { file: string; heading: string }\n  price: number\n  status: \"published\" | \"draft\"\n  collection?: string\n  /** Files the buyer receives. Paths are relative to BRAND_ASSETS_DIR. */\n  files: string[]\n  /** Product images, first one is the thumbnail. Paths are relative to BRAND_ASSETS_DIR. */\n  images: string[]\n  metadata?: Record<string, unknown>\n}\n\nexport type Brand = {\n  name: string\n  tagline: string\n  contactEmail: string\n  store: { currency: string; regionName: string; countries: string[] }\n  collections?: { handle: string; title: string }[]\n  catalog: BrandCatalogItem[]\n}\n\n/** The `brand/` folder at the repository root. */\nexport function brandRoot(): string {\n  return process.env.BRAND_DIR || path.resolve(process.cwd(), \"../../brand\")\n}\n\n/** The active brand's folder name: `BRAND` env, else the `brand/.active` file. */\nexport function activeBrandName(): string {\n  if (process.env.BRAND) {\n    return process.env.BRAND\n  }\n  return fs.readFileSync(path.join(brandRoot(), \".active\"), \"utf8\").trim()\n}\n\nexport function loadBrand(): Brand {\n  const file = path.join(brandRoot(), activeBrandName(), \"brand.json\")\n  return JSON.parse(fs.readFileSync(file, \"utf8\")) as Brand\n}\n\n/**\n * Where product files and images live. They stay outside the repository so\n * the things being sold are never committed.\n */\nexport function brandAssetsDir(): string {\n  const dir = process.env.BRAND_ASSETS_DIR\n  if (!dir) {\n    throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"Set BRAND_ASSETS_DIR to the folder holding product files.\")",[0,756],"import { MedusaError } from \"@medusajs/framework/utils\"\nimport { createHmac, timingSafeEqual } from \"crypto\"\n\nexport type DownloadTokenPayload = {\n  // digital_product_order id: proves which purchase the link belongs to\n  dpo: string\n  // digital_product_media id\n  media: string\n  // expiry, unix seconds\n  exp: number\n}\n\nconst DAY = 60 * 60 * 24\n\n/** How long a link sent by email stays valid. */\nexport const EMAIL_LINK_TTL_SECONDS =\n  Number(process.env.DOWNLOAD_LINK_TTL_DAYS || 7) * DAY\n\n/** How long a link shown on a page (library, order confirmation) stays valid. */\nexport const PAGE_LINK_TTL_SECONDS = 60 * 60\n\nfunction secret(): string {\n  const value = process.env.DOWNLOAD_TOKEN_SECRET || process.env.JWT_SECRET\n  if (!value) {\n    throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"DOWNLOAD_TOKEN_SECRET or JWT_SECRET must be set\")"]